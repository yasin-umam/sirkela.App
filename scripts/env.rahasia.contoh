# Salin jadi .env.rahasia (sudah di-gitignore) di akar proyek, isi dari dashboard
# project Supabase PEMBELI (Project Settings -> API). Satu berkas per project.
#
# PERINGATAN: service role key mem-bypass semua RLS. Jangan taruh di .env biasa,
# jangan pakai awalan VITE_ (ikut tertanam ke bundel yang dilihat siapa saja),
# jangan dikirim ke pembeli, jangan di-commit.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
